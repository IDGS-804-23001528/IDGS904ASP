@model IDGS904ASP.Models.Cinepolis

@{
    ViewBag.Title = "Cinepolis";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>Cinepolis - Venta de Boletos</h2>
        </div>
        <div class="card-body">
            @using (Html.BeginForm())
            {
                <div class="form-group mb-3">
                    <label>Nombre:</label>
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                </div>

                <div class="form-group mb-3">
                    <label>Cantidad Compradores:</label>
                    @Html.TextBoxFor(m => m.CantidadCompradores, new { @class = "form-control", type = "number" })
                </div>

                <div class="form-group mb-3">
                    <label>Cantidad Boletos:</label>
                    @Html.TextBoxFor(m => m.CantidadBoletos, new { @class = "form-control", type = "number" })
                </div>

                <div class="form-group mb-3">
                    <label>¿Cuenta con Tarjeta CINECO?</label><br />
                    <div class="form-check form-check-inline">
                        @Html.RadioButtonFor(m => m.Tarjeta, true, new { @class = "form-check-input" }) Sí
                    </div>
                    <div class="form-check form-check-inline">
                        @Html.RadioButtonFor(m => m.Tarjeta, false, new { @class = "form-check-input" }) No
                    </div>
                </div>

                <button type="submit" class="btn btn-success">Procesar</button>
            }

            <hr />

            @* Resultados *@
            @if (ViewBag.Total != null)
            {
                <div class="alert alert-info">
                    <h3>Cliente: @ViewBag.Nombre</h3>
                    <h3>Total a pagar: @string.Format("{0:C}", ViewBag.Total)</h3>
                </div>
            }

            @* Errores *@
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    <h4>@ViewBag.Error</h4>
                </div>
            }
        </div>
    </div>
</div>